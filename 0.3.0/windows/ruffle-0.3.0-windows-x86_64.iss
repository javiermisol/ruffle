[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked
Name: "quicklaunchicon"; Description: "{cm:CreateQuickLaunchIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked; OnlyBelowVersion: 0,6.1

[Files]
Source: "D:\Programación\Windows\Apps\Ruffle\3.0\ruffle-0.3.0-windows-x86_64\bin\ruffle.exe"; DestDir: "{app}/bin"; Flags: ignoreversion
Source: "ruffle-0.3.0-windows-x86_64\icons\favicon.ico"; DestDir: "{app}\icons"; Flags: ignoreversion
Source: "ruffle-0.3.0-windows-x86_64\docs\LICENSE.md"; DestDir: "{app}\docs"; Flags: ignoreversion
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Icons]
Name: "{group}\Ruffle"; Filename: "{app}\bin\ruffle.exe"; IconFilename: "{app}\icons\favicon.ico"; IconIndex: 0; Comment: "A Flash Player emulator written in Rust"
Name: "{group}\{cm:ProgramOnTheWeb,Ruffle}"; Filename: "https://ruffle.rs/"
Name: "{group}\{cm:UninstallProgram,Ruffle}"; Filename: "{uninstallexe}"
Name: "{commondesktop}\Ruffle"; Filename: "{app}\bin\ruffle.exe"; IconFilename: "{app}\icons\favicon.ico"; IconIndex: 0; Comment: "A Flash Player emulator written in Rust"; Tasks: desktopicon
Name: "{userappdata}\Microsoft\Internet Explorer\Quick Launch\Ruffle"; Filename: "{app}\bin\ruffle.exe"; IconFilename: "{app}\icons\favicon.ico"; IconIndex: 0; Comment: "A Flash Player emulator written in Rust"; Tasks: quicklaunchicon

[Run]
Filename: "{app}\bin\ruffle.exe"; Description: "{cm:LaunchProgram,Ruffle}"; Flags: nowait postinstall skipifsilent
