[Setup]
; NOTE: The value of AppId uniquely identifies this application.
; Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{060BAF13-F913-47D2-99A1-5504676249BA}
AppName=Ruffle
AppVersion=0.3.0
;AppVerName=Ruffle 0.3.0
AppPublisher=� 2026 Ruffle Team
AppPublisherURL=https://ruffle.rs/
AppSupportURL=https://ruffle.rs/
AppUpdatesURL=https://ruffle.rs/
DefaultDirName={pf64}\Ruffle
DefaultGroupName=Ruffle
AllowNoIcons=yes
LicenseFile=D:\Programación\Windows\Apps\Ruffle\3.0\ruffle-0.3.0-windows-x86_64\docs\LICENSE.md
OutputDir=D:\Programación\Apps\Win\Apps\Ruffle\3.0
OutputBaseFilename=ruffle-0.3.0-windows-x86_64
SetupIconFile=D:\Programación\Windows\Apps\Ruffle\3.0\ruffle-0.3.0-windows-x86_64\icons\favicon.ico
Compression=lzma
SolidCompression=yes

[Languages]
